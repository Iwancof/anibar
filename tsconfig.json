{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "module": "ES2022",
    "target": "ES2020",
    "lib": ["ES2023"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    // "checkJs": true,
    // "allowJs": true,
    "jsx": "react-jsx",
    "jsxImportSource": "ags/gtk4"
  },
  "include": ["app.ts", "env.d.ts", "widget/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"]
}
